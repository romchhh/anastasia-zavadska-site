# Публічний URL сайту (WayForPay, редіректи). У dev з ngrok hostname з цієї змінної автоматично потрапляє в allowedDevOrigins (HMR).
# NEXT_PUBLIC_SITE_URL=https://xxxx.ngrok-free.dev

# Опційно, dev: додаткові хости для HMR (через кому, без https://)
# NEXT_DEV_ALLOWED_ORIGINS=other-host.dev
