TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Ціна індивідуальної сесії в грн (WayForPay)
SESSION_PRICE_UAH=2100

# Після успішної оплати — посилання на вашого Telegram-бота або чат (публічна змінна)
