# Рядки 1–2: бот у групі (сповіщення про записи та оплати)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Сума за індивідуальну сесію в WayForPay (USD), наприклад 50
SESSION_PRICE_USD=50

# Тест: 1 грн за онлайн-сесію в WayForPay (UAH). Для бойового режиму видаліть рядок або поставте 0
# SESSION_WAYFORPAY_TEST_1UAH=1

# Після успішної оплати — посилання на вашого Telegram-бота або чат (публічна змінна)
NEXT_PUBLIC_PAYMENT_SUCCESS_TELEGRAM_URL=https://t.me/anastasia_zavadska

# Публічний URL сайту (WayForPay, редіректи). У dev з ngrok hostname з цієї змінної автоматично потрапляє в allowedDevOrigins (HMR).
# NEXT_PUBLIC_SITE_URL=https://xxxx.ngrok-free.dev

# Meta Pixel (публічний id) + Conversions API (секретний маркер лише на сервері, не комітити)
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=

# Опційно, dev: додаткові хости для HMR (через кому, без https://)
# NEXT_DEV_ALLOWED_ORIGINS=other-host.dev
